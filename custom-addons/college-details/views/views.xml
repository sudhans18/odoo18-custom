<odoo>
  <data>
    <!-- Student Details List View -->
    <record model="ir.ui.view" id="student_details_list">
      <field name="name">Student Details List</field>
      <field name="model">student.details</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="email"/>
          <field name="phone"/>
          <field name="course"/>
          <field name="quotation_id"/>
          <field name="create_date"/>
        </list>
      </field>
    </record>

    <!-- Student Details Form View -->
    <record model="ir.ui.view" id="student_details_form">
      <field name="name">Student Details Form</field>
      <field name="model">student.details</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_generate_pdf" string="Generate PDF" type="object" class="btn-primary"/>
          </header>
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="gender"/>
              </group>
              <group>
                <field name="course"/>
                <field name="date_of_birth"/>
                <field name="quotation_id"/>
              </group>
            </group>
            <group>
              <field name="address"/>
              <field name="notes"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Student Details Action Window -->
    <record model="ir.actions.act_window" id="student_details_action">
      <field name="name">Student Details</field>
      <field name="res_model">student.details</field>
      <field name="view_mode">list,form</field>
      <field name="view_id" ref="student_details_list"/>
    </record>

    <!-- College Details App Menu Structure -->
    <menuitem name="College Details" id="college_details_menu_root" sequence="10" web_icon="college-details,static/description/icon.png"/>
    <menuitem name="Students" id="student_details_menu" parent="college_details_menu_root" action="student_details_action" sequence="10"/>
  </data>
</odoo>
